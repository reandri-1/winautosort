{
  "watch_directory": "%USERPROFILE%\\Downloads",
  "rules": [
    {
      "category": "image_download",
      "extensions": [
        ".jpg", ".jpeg", ".jpe", ".jfif", ".png", ".gif", ".webp", ".bmp", ".tif", ".tiff",
        ".ico", ".heic", ".heif", ".avif", ".svg", ".raw", ".cr2", ".cr3", ".nef", ".arw",
        ".dng", ".orf", ".rw2"
      ]
    },
    {
      "category": "video_download",
      "extensions": [
        ".mp4", ".mkv", ".webm", ".avi", ".mov", ".wmv", ".flv", ".f4v", ".m4v", ".mpg",
        ".mpeg", ".3gp", ".3g2", ".m2ts", ".mts", ".ogv", ".vob", ".divx", ".rm", ".rmvb",
        ".asf", ".srt", ".vtt", ".ass", ".sub"
      ]
    },
    {
      "category": "audio_download",
      "extensions": [
        ".mp3", ".wav", ".flac", ".aac", ".m4a", ".m4b", ".ogg", ".oga", ".opus", ".wma",
        ".aiff", ".aif", ".alac", ".amr", ".ape", ".mka", ".ac3", ".weba", ".mid", ".midi"
      ]
    },
    {
      "category": "document_download",
      "extensions": [
        ".pdf", ".doc", ".docx", ".docm", ".dot", ".dotx", ".odt", ".rtf", ".txt", ".md",
        ".tex", ".pages", ".wps", ".xps",
        ".xls", ".xlsx", ".xlsm", ".xlsb", ".ods", ".csv", ".tsv", ".numbers",
        ".ppt", ".pptx", ".pps", ".ppsx", ".odp", ".key"
      ]
    },
    {
      "category": "ebook_download",
      "extensions": [".epub", ".mobi", ".azw", ".azw3", ".fb2", ".djvu", ".cbz", ".cbr", ".lit"]
    },
    {
      "category": "archive_download",
      "extensions": [
        ".zip", ".rar", ".7z", ".tar", ".gz", ".tgz", ".bz2", ".tbz2", ".xz", ".txz",
        ".zst", ".lz", ".lzma", ".z", ".cab", ".arj"
      ]
    },
    {
      "category": "installer_download",
      "extensions": [
        ".exe", ".msi", ".msix", ".msixbundle", ".appx", ".appxbundle", ".msp", ".msu",
        ".apk", ".xapk", ".apks", ".aab", ".deb", ".rpm", ".dmg", ".pkg", ".appimage", ".jar"
      ]
    },
    {
      "category": "disk_image_download",
      "extensions": [".iso", ".img", ".vhd", ".vhdx", ".vmdk", ".vdi", ".wim"]
    },
    {
      "category": "font_download",
      "extensions": [".ttf", ".otf", ".woff", ".woff2", ".ttc", ".eot", ".fon"]
    },
    {
      "category": "design_download",
      "extensions": [
        ".psd", ".ai", ".eps", ".indd", ".xcf", ".sketch", ".fig", ".xd", ".afdesign",
        ".afphoto", ".cdr", ".blend", ".fbx", ".obj", ".stl", ".3mf", ".glb", ".gltf",
        ".dae", ".dwg", ".dxf", ".step", ".stp", ".skp", ".max", ".c4d"
      ]
    },
    {
      "category": "code_download",
      "extensions": [
        ".py", ".js", ".mjs", ".ts", ".tsx", ".jsx", ".java", ".c", ".h", ".cpp", ".hpp",
        ".cs", ".go", ".rs", ".php", ".rb", ".swift", ".kt", ".kts", ".lua", ".dart", ".r",
        ".pl", ".sh", ".bat", ".cmd", ".ps1", ".html", ".htm", ".css", ".scss", ".vue",
        ".ipynb", ".json", ".xml", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".sql", ".gradle"
      ]
    },
    {
      "category": "data_download",
      "extensions": [".db", ".sqlite", ".sqlite3", ".mdb", ".accdb", ".parquet", ".bak"]
    }
  ],
  "default_fallback": "file_download",
  "exclude_extensions": [
    ".crdownload", ".part", ".tmp", ".temp", ".partial", ".download", ".opdownload",
    ".crswap", ".filepart", ".!ut", ".!qb", ".bc!", ".aria2", ".idm", ".ytdl"
  ],
  "sweep_on_start": null,
  "lock_timeout_seconds": 7200,
  "max_workers": 4
}
